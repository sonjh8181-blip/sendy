# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, register this key in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side API key for direct calls.
VITE_GEMINI_API_KEY=""

# VITE_GAS_URL: Google Apps Script Web App endpoint URL.
VITE_GAS_URL="https://script.google.com/macros/s/AKfycbwI8ikYRFtHIIg6IrMK_B54Ms4RLE1XebtxG6kC-VXRM-bz_siFmcPAWP7APO9Dc-O4/exec"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
